{
  "name": "@buddyclub/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed fetch client for the platform API. Request/response types come from @buddyclub/shared-types, the same schemas that generate the OpenAPI document.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@buddyclub/shared-types": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
