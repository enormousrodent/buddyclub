{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["SUPABASE_JWT_SECRET", "SUPABASE_URL"]
    },
    "test:db": {
      "cache": false,
      "env": ["TEST_DATABASE_URL", "SUPABASE_JWT_SECRET", "SUPABASE_URL"]
    },
    "openapi:emit": {
      "outputs": ["../../docs/api/openapi.json"]
    }
  }
}
