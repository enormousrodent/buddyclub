{
  "name": "@buddyclub/platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Buddy Club platform API: the sole write surface for Buddy Club and Rally (Fastify + Zod + OpenAPI + Supabase Postgres).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "openapi:emit": "tsx src/openapi/emit.ts",
    "smoke": "node scripts/smoke.mjs dist/server.js",
    "demo": "node --env-file=.env --import tsx scripts/demo-content.ts"
  },
  "dependencies": {
    "@buddyclub/auth": "workspace:*",
    "@buddyclub/competition-engine": "workspace:*",
    "@buddyclub/rotation-engine": "workspace:*",
    "@buddyclub/rules-schema": "workspace:*",
    "@buddyclub/scoring-engine": "workspace:*",
    "@buddyclub/shared-types": "workspace:*",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "5.1.0",
    "jose": "6.2.12",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
