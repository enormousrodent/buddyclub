# Platform API (apps/platform-api). Copy to apps/platform-api/.env for local dev.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Option A: cloud Supabase project (current default for development)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xvkoukolmdpuvftvvcdd.supabase.co
# The project uses asymmetric (ES256) signing keys, so no shared secret is needed.
SUPABASE_JWKS_URL=https://xvkoukolmdpuvftvvcdd.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
# Direct Postgres connection used by the API (server-side only; from the dashboard, never committed).
# Project region is eu-west-1; the session pooler host is aws-0-eu-west-1.pooler.supabase.com (IPv4-friendly).
# DATABASE_URL=postgresql://postgres.xvkoukolmdpuvftvvcdd:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Option B: local Supabase (`pnpm db:start`; values from `pnpm db:status`)
# ---------------------------------------------------------------------------
# SUPABASE_URL=http://127.0.0.1:54321
# Local Supabase ships this well-known demo secret (HS256).
# SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional override; defaults to ${SUPABASE_URL}/auth/v1
# SUPABASE_JWT_ISSUER=

# Used only by DB-backed integration tests (pnpm test:db). Leave unset to skip them.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
