{
  "$schema": "https://json.schemastore.org/any",
  "name": "Buddy Club design tokens",
  "version": "2.0.0",
  "notes": "Source of truth for apps/web/app/globals.css and for the Expo theme later. Palette \"White with Cobalt and Coral\" chosen by the owner on 2026-10-20 (canvas \"Buddy Club palettes\"); layout, type, radii and spacing are unchanged from 1.x. Hex values are sRGB. Contrast figures are against white unless stated. The \"dark\" block lists the values that change in the dark theme; anything not listed keeps its light value. Night values are fixed in both themes.",
  "color": {
    "paper": {
      "value": "#FFFFFF",
      "role": "App ground"
    },
    "surface": {
      "value": "#FFFFFF",
      "role": "Cards, sheets, inputs (hairline-separated from the ground)"
    },
    "surface2": {
      "value": "#F3F5FA",
      "role": "Wells, segmented control track, resting strip"
    },
    "hairline": {
      "value": "#E3E7EF",
      "role": "1px borders and dividers"
    },
    "hairlineStrong": {
      "value": "#BFC7D6",
      "role": "Dashed empty-state borders"
    },
    "ink": {
      "value": "#141E33",
      "role": "Primary text, 16.6:1"
    },
    "ink2": {
      "value": "#33405C",
      "role": "Body text, 10.4:1"
    },
    "muted": {
      "value": "#5D6A85",
      "role": "Captions and labels, 5.4:1"
    },
    "buddyclub": {
      "primary": {
        "value": "#1D4FC4",
        "role": "Actions and links; white text 7.1:1"
      },
      "primaryStrong": {
        "value": "#163C96",
        "role": "Pressed primary"
      },
      "tint": {
        "value": "#E1EAFF",
        "role": "Selected, tonal buttons"
      },
      "tintInk": {
        "value": "#163C96"
      },
      "highlight": {
        "value": "#FF6B57",
        "role": "Coral. Decorative highlight only, never text"
      }
    },
    "rally": {
      "primary": {
        "value": "#2350D6",
        "role": "Actions and links; white text 6.6:1"
      },
      "primaryStrong": {
        "value": "#1B3FAE",
        "role": "Pressed primary"
      },
      "tint": {
        "value": "#E4EAFB",
        "role": "Selected, tonal buttons, shared-live pill"
      },
      "tintInk": {
        "value": "#1B3FAE"
      },
      "highlight": {
        "value": "#D9F74D",
        "role": "Live, on court, current round; ink text only"
      }
    },
    "live": {
      "value": "#D9F74D",
      "ink": "#141E33",
      "role": "Live pill and your-court border"
    },
    "info": {
      "value": "#ECE6FF",
      "ink": "#4B2AA6",
      "role": "Lavender, distinct from the cobalt tint"
    },
    "warning": {
      "value": "#FFF1D6",
      "ink": "#7A4D00"
    },
    "danger": {
      "value": "#B3261E",
      "soft": "#FBE9E7",
      "role": "Errors, destructive; never a product accent"
    },
    "success": {
      "value": "#DDF5E6",
      "ink": "#176A3B"
    },
    "onInk": {
      "ink": "#F6F8FF",
      "muted": "#A9B5D1",
      "hairline": "#34436A",
      "accent": "#D9F74D",
      "role": "Text, lines and the eyebrow on an ink surface (player hero, ink cards, selected chips)"
    },
    "night": {
      "ground": {
        "value": "#141E33"
      },
      "surface": {
        "value": "#1E2B47"
      },
      "hairline": {
        "value": "#34436A"
      },
      "ink": {
        "value": "#F6F8FF"
      },
      "muted": {
        "value": "#A9B5D1"
      },
      "role": "Venue board; fixed in both themes"
    },
    "swatches": {
      "values": ["#D6F5E3", "#FFE0D6", "#DCEBFF", "#FFF1B3", "#E9F7D2", "#F0E2FF"],
      "role": "Decorative covers and tiles; never carry text that must pass contrast"
    },
    "brandRally": {
      "value": "#2350D6",
      "role": "Rally's blue inside Buddy Club"
    }
  },
  "typography": {
    "families": {
      "sans": {
        "value": "Figtree",
        "fallback": "system-ui, sans-serif",
        "role": "Everything you read and tap"
      },
      "display": {
        "value": "Bricolage Grotesque",
        "fallback": "Figtree, system-ui, sans-serif",
        "role": "Page titles, hero lines, big court numbers"
      }
    },
    "scale": {
      "display": {
        "size": 34,
        "line": 38,
        "weight": 700,
        "family": "display",
        "tracking": -0.02
      },
      "pageTitle": {
        "size": 28,
        "line": 32,
        "weight": 700,
        "family": "display",
        "tracking": -0.02
      },
      "heading": {
        "size": 26,
        "line": 30,
        "weight": 700,
        "family": "display",
        "tracking": -0.02
      },
      "title": {
        "size": 20,
        "line": 26,
        "weight": 700
      },
      "body": {
        "size": 16,
        "line": 24,
        "weight": 400
      },
      "bodyStrong": {
        "size": 16,
        "line": 24,
        "weight": 600
      },
      "label": {
        "size": 13,
        "line": 18,
        "weight": 600,
        "tracking": 0.02
      },
      "section": {
        "size": 13,
        "line": 18,
        "weight": 700,
        "tracking": 0.06,
        "transform": "uppercase"
      },
      "caption": {
        "size": 12,
        "line": 16,
        "weight": 400
      },
      "timerHero": {
        "size": 72,
        "line": 72,
        "weight": 800,
        "tracking": -0.04,
        "numerals": "tabular"
      },
      "timerCard": {
        "size": 24,
        "line": 28,
        "weight": 800,
        "numerals": "tabular"
      },
      "courtCard": {
        "size": 44,
        "line": 44,
        "weight": 800,
        "family": "display",
        "tracking": -0.03
      },
      "courtHero": {
        "size": 120,
        "line": 110,
        "weight": 800,
        "family": "display",
        "tracking": -0.05
      }
    },
    "rules": [
      "Minimum 16px for anything read outdoors",
      "13px only for labels that pass 4.5:1",
      "Timers and court numbers always tabular numerals"
    ]
  },
  "spacing": {
    "base": 4,
    "steps": [4, 8, 12, 16, 20, 24, 32, 40],
    "screenGutter": 20,
    "cardPadding": 16,
    "sectionGap": 24
  },
  "radius": {
    "control": 12,
    "card": 16,
    "sheet": 24,
    "pill": 999,
    "hero": 20
  },
  "elevation": {
    "flat": {
      "shadow": "none",
      "border": "hairline",
      "role": "Cards and lists"
    },
    "raised": {
      "shadow": "0 1px 2px rgba(20,30,51,0.06), 0 4px 12px rgba(20,30,51,0.06)",
      "role": "Selected segment, floating chips"
    },
    "sheet": {
      "shadow": "0 12px 32px rgba(20,30,51,0.14)",
      "role": "Bottom sheets and dialogs"
    }
  },
  "touch": {
    "minimum": 44,
    "control": 48,
    "primary": 56,
    "liveAction": 64
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "easing": "ease-out",
    "rules": [
      "Sheets slide up, nothing bounces",
      "Timers tick without animation",
      "Respect reduced motion"
    ]
  },
  "dark": {
    "role": "Dark theme. Contrast figures are against the dark paper (#0F1729).",
    "paper": "#0F1729",
    "surface": "#141E33",
    "surface2": "#1E2B47",
    "hairline": "#2B3A5C",
    "hairlineStrong": "#4B5B82",
    "ink": "#F6F8FF",
    "ink2": "#CBD3E6",
    "muted": {
      "value": "#A3AFCB",
      "contrast": "8.1:1"
    },
    "buddyclub": {
      "primary": {
        "value": "#8FB0FF",
        "role": "Text 8.4:1; buttons take dark ink"
      },
      "primaryStrong": "#A9C2FF",
      "primaryInk": "#0F1729",
      "tint": "#1C2A52",
      "tintInk": "#BCCBFF",
      "highlight": "#FF8A78"
    },
    "rally": {
      "primary": {
        "value": "#8FB0FF"
      },
      "primaryStrong": "#A9C2FF",
      "primaryInk": "#0F1729",
      "tint": "#1C2A52",
      "tintInk": "#BCCBFF",
      "highlight": "#D9F74D"
    },
    "info": {
      "value": "#2A1F5C",
      "ink": "#CDBFFF"
    },
    "warning": {
      "value": "#3A2C0F",
      "ink": "#F3CD7A"
    },
    "danger": {
      "value": "#FF8F85",
      "soft": "#3B1B19"
    },
    "success": {
      "value": "#163A2A",
      "ink": "#A9E2C1"
    },
    "onInk": {
      "ink": "#0F1729",
      "muted": "#4B5B82",
      "hairline": "#CBD3E6",
      "accent": "#B2371F"
    },
    "swatches": ["#1E3A2E", "#3B2A24", "#1C2A52", "#3B3416", "#2B3A22", "#2E2447"],
    "brandRally": "#8FB0FF",
    "elevation": {
      "raised": "0 1px 2px rgba(0,0,0,0.4), 0 4px 12px rgba(0,0,0,0.35)",
      "sheet": "0 12px 32px rgba(0,0,0,0.6)"
    }
  }
}
