{
  "$schema": "https://json.schemastore.org/any",
  "name": "Buddy Club design tokens",
  "version": "1.1.0",
  "notes": "Source of truth for apps/web/app/globals.css today and for the Expo theme later. Hex values are sRGB. Contrast figures are against paper (#F6F3EC) unless stated. The \"dark\" block lists the values that change in the Clubhouse theme; anything not listed keeps its light value. Night values are fixed in both themes.",
  "color": {
    "paper": {
      "value": "#F6F3EC",
      "role": "App ground"
    },
    "surface": {
      "value": "#FFFFFF",
      "role": "Cards, sheets, inputs"
    },
    "surface2": {
      "value": "#EFEBE2",
      "role": "Wells, segmented control track, resting strip"
    },
    "hairline": {
      "value": "#E3DED3",
      "role": "1px borders and dividers"
    },
    "hairlineStrong": {
      "value": "#C9C2B4",
      "role": "Dashed empty-state borders"
    },
    "ink": {
      "value": "#172019",
      "role": "Primary text, 13.9:1"
    },
    "ink2": {
      "value": "#3E4A42",
      "role": "Body text on paper, 8.6:1"
    },
    "muted": {
      "value": "#66716A",
      "role": "Captions and labels, 4.9:1"
    },
    "buddyclub": {
      "primary": {
        "value": "#1F5F43",
        "role": "Actions and links; white text 7.4:1"
      },
      "primaryStrong": {
        "value": "#174A34",
        "role": "Pressed primary"
      },
      "tint": {
        "value": "#E3EFE7",
        "role": "Selected, tonal buttons, success"
      },
      "tintInk": {
        "value": "#1F5F43"
      },
      "highlight": {
        "value": "#E7A33A",
        "role": "Decorative highlight only, never text"
      }
    },
    "rally": {
      "primary": {
        "value": "#2350D6",
        "role": "Actions and links; white text 6.4:1"
      },
      "primaryStrong": {
        "value": "#1B3FAE",
        "role": "Pressed primary"
      },
      "tint": {
        "value": "#E4EAFB",
        "role": "Selected, tonal buttons, shared-live pill"
      },
      "tintInk": {
        "value": "#1B3FAE"
      },
      "highlight": {
        "value": "#C9F24A",
        "role": "Live, on court, current round; ink text only"
      }
    },
    "live": {
      "value": "#C9F24A",
      "ink": "#172019",
      "role": "Live pill and your-court border"
    },
    "info": {
      "value": "#E4EAFB",
      "ink": "#1B3FAE"
    },
    "warning": {
      "value": "#FFF1D6",
      "ink": "#7A4D00"
    },
    "danger": {
      "value": "#B3261E",
      "soft": "#FBE9E7",
      "role": "Errors, destructive; never a product accent"
    },
    "success": {
      "value": "#E3EFE7",
      "ink": "#1F5F43"
    },
    "night": {
      "ground": {
        "value": "#0F1A14"
      },
      "surface": {
        "value": "#16241C"
      },
      "hairline": {
        "value": "#2E3D34"
      },
      "ink": {
        "value": "#F3F0E8"
      },
      "muted": {
        "value": "#A9B5AD"
      },
      "role": "Player hero card now; optional Rally dark theme for halls later"
    },
    "onInk": {
      "ink": "#F3F0E8",
      "muted": "#A9B5AD",
      "hairline": "#2E3D34",
      "accent": "#C9F24A",
      "role": "Text, lines and the eyebrow on an ink surface (player hero, ink cards, selected chips)"
    },
    "swatches": {
      "values": ["#CFD9CC", "#E6D9C4", "#E4EAFB", "#FBEFD9", "#E6EDD6", "#F3E6D2"],
      "role": "Decorative covers and tiles; never carry text that must pass contrast"
    },
    "brandRally": {
      "value": "#2350D6",
      "role": "Rally's blue inside Buddy Club"
    }
  },
  "typography": {
    "families": {
      "sans": {
        "value": "Figtree",
        "fallback": "system-ui, sans-serif",
        "role": "Everything you read and tap"
      },
      "display": {
        "value": "Bricolage Grotesque",
        "fallback": "Figtree, system-ui, sans-serif",
        "role": "Page titles, hero lines, big court numbers"
      }
    },
    "scale": {
      "display": {
        "size": 34,
        "line": 38,
        "weight": 700,
        "family": "display",
        "tracking": -0.02
      },
      "pageTitle": {
        "size": 28,
        "line": 32,
        "weight": 700,
        "family": "display",
        "tracking": -0.02
      },
      "heading": {
        "size": 26,
        "line": 30,
        "weight": 700,
        "family": "display",
        "tracking": -0.02
      },
      "title": {
        "size": 20,
        "line": 26,
        "weight": 700
      },
      "body": {
        "size": 16,
        "line": 24,
        "weight": 400
      },
      "bodyStrong": {
        "size": 16,
        "line": 24,
        "weight": 600
      },
      "label": {
        "size": 13,
        "line": 18,
        "weight": 600,
        "tracking": 0.02
      },
      "section": {
        "size": 13,
        "line": 18,
        "weight": 700,
        "tracking": 0.06,
        "transform": "uppercase"
      },
      "caption": {
        "size": 12,
        "line": 16,
        "weight": 400
      },
      "timerHero": {
        "size": 72,
        "line": 72,
        "weight": 800,
        "tracking": -0.04,
        "numerals": "tabular"
      },
      "timerCard": {
        "size": 24,
        "line": 28,
        "weight": 800,
        "numerals": "tabular"
      },
      "courtCard": {
        "size": 44,
        "line": 44,
        "weight": 800,
        "family": "display",
        "tracking": -0.03
      },
      "courtHero": {
        "size": 120,
        "line": 110,
        "weight": 800,
        "family": "display",
        "tracking": -0.05
      }
    },
    "rules": [
      "Minimum 16px for anything read outdoors",
      "13px only for labels that pass 4.5:1",
      "Timers and court numbers always tabular numerals"
    ]
  },
  "spacing": {
    "base": 4,
    "steps": [4, 8, 12, 16, 20, 24, 32, 40],
    "screenGutter": 20,
    "cardPadding": 16,
    "sectionGap": 24
  },
  "radius": {
    "control": 12,
    "card": 16,
    "sheet": 24,
    "pill": 999,
    "hero": 20
  },
  "elevation": {
    "flat": {
      "shadow": "none",
      "border": "hairline",
      "role": "Cards and lists"
    },
    "raised": {
      "shadow": "0 1px 2px rgba(23,32,25,0.06), 0 4px 12px rgba(23,32,25,0.06)",
      "role": "Selected segment, floating chips"
    },
    "sheet": {
      "shadow": "0 12px 32px rgba(23,32,25,0.14)",
      "role": "Bottom sheets and dialogs"
    }
  },
  "touch": {
    "minimum": 44,
    "control": 48,
    "primary": 56,
    "liveAction": 64
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "easing": "ease-out",
    "rules": [
      "Sheets slide up, nothing bounces",
      "Timers tick without animation",
      "Respect reduced motion"
    ]
  },
  "dark": {
    "role": "Clubhouse theme (direction C). Contrast figures are against the dark paper (#0F1A14).",
    "paper": "#0F1A14",
    "surface": "#16241C",
    "surface2": "#1E2F25",
    "hairline": "#2A3B31",
    "hairlineStrong": "#4A5E52",
    "ink": "#F3F0E8",
    "ink2": "#CDD5CF",
    "muted": {
      "value": "#9DB0A3",
      "contrast": "7.8:1"
    },
    "buddyclub": {
      "primary": {
        "value": "#5CBD87",
        "role": "Text 7.7:1; buttons take dark ink"
      },
      "primaryStrong": "#78CF9F",
      "primaryInk": "#0F1A14",
      "tint": "#1D3729",
      "tintInk": "#A9E2C1",
      "highlight": "#E7A33A"
    },
    "rally": {
      "primary": {
        "value": "#7B9DFF",
        "role": "Text 6.9:1; buttons take dark ink"
      },
      "primaryStrong": "#97B2FF",
      "primaryInk": "#0F1A14",
      "tint": "#1C2A4F",
      "tintInk": "#BCCBFF",
      "highlight": "#C9F24A"
    },
    "info": {
      "value": "#1C2A4F",
      "ink": "#BCCBFF"
    },
    "warning": {
      "value": "#3A2C0F",
      "ink": "#F3CD7A"
    },
    "danger": {
      "value": "#FF8F85",
      "soft": "#3B1B19"
    },
    "success": {
      "value": "#1D3729",
      "ink": "#A9E2C1"
    },
    "onInk": {
      "ink": "#0F1A14",
      "muted": "#55655B",
      "hairline": "#D6D0C2",
      "accent": "#7A4D00"
    },
    "swatches": ["#243A2E", "#3A3222", "#1F2B4A", "#3B2F16", "#2B3A22", "#3A2E1E"],
    "brandRally": "#7B9DFF",
    "elevation": {
      "raised": "0 1px 2px rgba(0,0,0,0.4), 0 4px 12px rgba(0,0,0,0.35)",
      "sheet": "0 12px 32px rgba(0,0,0,0.6)"
    }
  }
}
